{
	"name": "commit-ia-task",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:visual": "bun scripts/visual-review.ts",
		"validate:frontend": "bun run check && bun run typecheck && bun run test",
		"validate": "bun run validate:frontend && bun run validate:rust && bun run build",
		"check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets --locked",
		"format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
		"format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
		"lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
		"bench:rust": "cargo bench --manifest-path src-tauri/Cargo.toml --locked --bench time_log_planner",
		"validate:rust": "bun run format:rust:check && bun run lint:rust && bun run test:rust",
		"tasks": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin infortech --",
		"tasks:install": "cargo install --locked --force --path src-tauri --bin infortech",
		"timelog": "cargo run --manifest-path src-tauri/Cargo.toml --bin timelog-bot --",
		"timelog:install": "cargo install --locked --force --path src-tauri --bin timelog-bot",
		"format": "biome check --write .",
		"check": "biome check .",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"macos:install": "bash scripts/install-macos.sh"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@tauri-apps/api": "2.11.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.31.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "2.11.4",
		"@testing-library/jest-dom": "7.0.0",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "26.1.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.4",
		"jsdom": "29.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "7.0.2",
		"vite": "8.1.5",
		"vitest": "4.1.10"
	}
}
