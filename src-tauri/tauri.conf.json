{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Infortech Automation",
	"version": "0.1.0",
	"identifier": "com.ygorazambuja.commit-ia-task",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Infortech Automation",
				"width": 1440,
				"height": 900,
				"minWidth": 860,
				"minHeight": 640,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:*; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
		}
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"targets": "all",
		"category": "DeveloperTool",
		"shortDescription": "Gera tarefas a partir de alterações Git",
		"macOS": {
			"minimumSystemVersion": "13.3",
			"signingIdentity": "-"
		},
		"windows": {
			"minimumWebview2Version": "111.0.1661.15"
		}
	}
}
